{
  "version": "2.0",
  "logging": {
    "applicationInsights": {
      "samplingSettings": {
        "isEnabled": true,
        "maxTelemetryItemsPerSecond": 20
      }
    }
  },
  "extensionBundle": {
    "id": "Microsoft.Azure.Functions.ExtensionBundle",
    "version": "[4.*, 5.0.0)"
  },
  "functionTimeout": "00:05:00",
  "tracing": {
    "consoleLevel": "information"
  },
  "httpWorker": {
    "description": {
      "defaultExecutionContext": "python",
      "version": "3.11"
    }
  },
  "cors": {
    "allowedOrigins": ["*"],
    "supportCredentials": false
  }
}
